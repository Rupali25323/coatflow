          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Live dashboard payload', function () { var data = pm.response.json(); pm.expect(data).to.have.property('totalRevenue'); pm.expect(data.revenueSeries).to.have.lengthOf(12); pm.expect(data.recentOrders).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
